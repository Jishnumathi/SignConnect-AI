# SignConnect AI Environment Configurations Template

# Flask Security Secrets
SECRET_KEY=signconnect_super_secret_key_12345

# Database Selector
# Options: sqlite, mongodb, postgres
DB_TYPE=sqlite

# SQLite Config
SQLITE_DB_PATH=database/signconnect.db

# MongoDB Config (Optional)
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=signconnect_ai

# PostgreSQL Config (Optional)
POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/signconnect_ai

# API Rate Limits
RATE_LIMIT_DEFAULT=100 per minute
RATE_LIMIT_AUTH=5 per minute

# AI Settings
PREDICTION_MIN_CONFIDENCE=0.45
MODEL_VERSION=1.0.0
